                  "key": "status",
                  "value": "berjalan",
                  "description": "booked | berjalan | selesai | batal"
                },
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "1-100"
                }
              ]
            },
            "description": "Setiap item menyertakan relasi `mobil` dan `pelanggan`. Filter lain: `mobil_id`, `pelanggan_id`, `kode_booking`, `dari`, `sampai`, `search`, `sort_by`, `sort_dir`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('relasi mobil dan pelanggan ikut', function () {",
                  "    var data = pm.response.json().data;",
                  "    if (data.length > 0) {",
                  "        pm.expect(data[0]).to.have.property('mobil');",
