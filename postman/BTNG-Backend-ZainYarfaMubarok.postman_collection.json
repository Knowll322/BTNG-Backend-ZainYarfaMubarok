    {
      "name": "Penyewaan",
      "description": "Transaksi rental. Server menghitung `kode_booking`, `durasi_hari` (inklusif), `harga_sewa_per_hari`, dan `total_biaya`. Tanggal divalidasi anti-bentrok per unit.\n\nFolder ini punya pre-request script yang mengisi `tanggalMulai` (+7 hari) dan `tanggalSelesai` (+9 hari) secara otomatis.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var mulai = new Date();",
              "mulai.setDate(mulai.getDate() + 7);",
              "",
              "var selesai = new Date(mulai.getTime());",
              "selesai.setDate(selesai.getDate() + 2);",
              "",
              "function iso(d) {",
              "    var bulan = ('0' + (d.getMonth() + 1)).slice(-2);",
              "    var hari = ('0' + d.getDate()).slice(-2);",
              "    return d.getFullYear() + '-' + bulan + '-' + hari;",
              "}",
              "",
              "pm.collectionVariables.set('tanggalMulai', iso(mulai));",
              "pm.collectionVariables.set('tanggalSelesai', iso(selesai));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Daftar penyewaan",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/penyewaan?status=berjalan&per_page=10",
